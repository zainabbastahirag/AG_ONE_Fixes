        <mxCell id="r13" value="1..*" style="edgeStyle=entityRelationEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="t_features" target="t_bridge"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r14" value="unlocks permission" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERone;startArrow=ERmany;strokeColor=#82b366;strokeWidth=2;fontStyle=1;" edge="1" parent="1" source="t_bridge" target="t_perms"><mxGeometry relative="1" as="geometry" /></mxCell>

