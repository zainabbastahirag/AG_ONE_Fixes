<mxfile host="app.diagrams.net" agent="AG ONE architecture" version="24.0.0">
  <diagram id="arch" name="1. Solution Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="AG ONE — Subscription &amp; Entitlement Architecture&#10;Effective access = RBAC permission  AND  plan entitlement" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1520" height="50" as="geometry" />
        </mxCell>

        <!-- Layer group boxes -->
        <mxCell id="g_app" value="Product app (hire / learn / work) — ASP.NET Core 8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="110" width="360" height="420" as="geometry" />
        </mxCell>
        <mxCell id="g_engine" value="AgOne.Entitlements — shared engine (no ASP.NET dependency)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="700" y="110" width="360" height="500" as="geometry" />
        </mxCell>
        <mxCell id="g_adapt" value="Adapters (per app)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1100" y="110" width="220" height="500" as="geometry" />
        </mxCell>
        <mxCell id="g_data" value="Data &amp; billing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1360" y="110" width="200" height="500" as="geometry" />
        </mxCell>

        <!-- Client -->
        <mxCell id="client" value="Browser / API client / Mobile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- App pipeline nodes -->
        <mxCell id="mw" value="TenantResolutionMiddleware&#10;reads tenant_id + user_id claims → TenantContext" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="320" y="150" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="authz" value="[RequirePermission] / [RequireFeature]&#10;+ EntitlementPolicyProvider (dynamic policies)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="320" y="250" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="handler" value="EntitlementAuthorizationHandler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="320" y="350" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="outcome" value="Outcome&#10;200 Allow  •  403 role denies  •  402 plan/billing (upsell)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="320" y="430" width="320" height="70" as="geometry" />
        </mxCell>

        <!-- Engine nodes -->
        <mxCell id="resolver" value="AccessResolver&#10;Effective = RBAC ∩ Entitlement&#10;(Allow / NotPermittedByRole / NotIncludedInPlan / SubscriptionInactive)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="150" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="entsvc" value="EntitlementService&#10;builds EntitlementSnapshot (status + grace/trial/expiry)&#10;wrapped by CachingEntitlementService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="720" y="270" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="catalog" value="PlanCatalog (source of truth)&#10;Features → permission codes, Plans → features&#10;hire / learn / work" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="720" y="390" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cache" value="Snapshot cache (IMemoryCache)&#10;keyed by (tenant, product), short TTL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="510" width="320" height="70" as="geometry" />
        </mxCell>

        <!-- Adapters -->
        <mxCell id="upp" value="IUserPermissionProvider&#10;EF query over core.*&#10;(existing RBAC — reused as-is)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1120" y="170" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ss" value="ISubscriptionStore&#10;EF query over billing.*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1120" y="320" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="webhook" value="Billing webhook handler&#10;upsert subscription + invalidate cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1120" y="470" width="180" height="90" as="geometry" />
        </mxCell>

        <!-- Data stores -->
        <mxCell id="coredb" value="core.*  (existing)&#10;Users, Roles, Permissions,&#10;UserRoles, RolePermissions" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1380" y="160" width="160" height="110" as="geometry" />
        </mxCell>
        <mxCell id="billdb" value="billing.*  (new)&#10;Plans, Features, PlanFeatures,&#10;FeaturePermissions, Tenants,&#10;Subscriptions, AddOns" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1380" y="300" width="160" height="120" as="geometry" />
        </mxCell>
        <mxCell id="stripe" value="Billing provider&#10;(Stripe / payment)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1380" y="470" width="160" height="90" as="geometry" />
        </mxCell>

        <!-- Bridge note -->
        <mxCell id="bridge" value="THE BRIDGE&#10;billing.FeaturePermissions joins to core.Permissions by permission code — the only new link needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="700" y="640" width="620" height="60" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="client" target="mw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="mw" target="authz"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="authz" target="handler"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="decision" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="handler" target="outcome"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="authorize permission" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="handler" target="resolver"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="RBAC permissions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="resolver" target="upp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="entitlement snapshot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="resolver" target="entsvc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="entsvc" target="catalog"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="entsvc" target="cache"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="load subscription" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="entsvc" target="ss"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="upp" target="coredb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="ss" target="billdb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" value="events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="stripe" target="webhook"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" value="upsert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="webhook" target="billdb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" value="invalidate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="webhook" target="cache"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="billdb" target="coredb"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="erd" name="2. Data Model (ERD)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="etitle" value="Data model — billing.* layered on existing core.* (joined by permission code)" style="text;html=1;align=center;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1520" height="30" as="geometry" />
        </mxCell>

        <!-- core.* existing -->
        <mxCell id="c_box" value="core.*  (EXISTING RBAC — unchanged)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="360" height="560" as="geometry" />
        </mxCell>
        <mxCell id="t_users" value="core.Users&#10;──────────&#10;UserId (PK)&#10;Email, ..." style="whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="70" y="120" width="140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="t_userroles" value="core.UserRoles&#10;──────────&#10;UserId (FK)&#10;RoleId (FK)" style="whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="230" y="120" width="140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="t_roles" value="core.Roles&#10;──────────&#10;RoleId (PK)&#10;Name" style="whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="230" y="260" width="140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="t_roleperms" value="core.RolePermissions&#10;──────────&#10;RoleId (FK)&#10;PermissionId (FK)" style="whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="230" y="400" width="140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="t_perms" value="core.Permissions&#10;──────────&#10;PermissionId (PK)&#10;Code  (e.g. hire.employee.write)" style="whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="400" width="140" height="110" as="geometry" />
        </mxCell>

        <!-- billing.* new -->
        <mxCell id="b_box" value="billing.*  (NEW)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="80" width="1080" height="700" as="geometry" />
        </mxCell>
        <mxCell id="t_products" value="billing.Products&#10;──────────&#10;ProductId (PK)&#10;Key (hire/learn/work)" style="whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="520" y="120" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="t_features" value="billing.Features&#10;──────────&#10;FeatureId (PK)&#10;Key, ProductId (FK)&#10;Name, IsComingSoon" style="whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="520" y="270" width="180" height="120" as="geometry" />
        </mxCell>
        <mxCell id="t_featperms" value="billing.FeaturePermissions&#10;──────────&#10;FeatureId (FK)&#10;PermissionCode  ⟶ core.Permissions.Code" style="whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="440" width="180" height="120" as="geometry" />
        </mxCell>
        <mxCell id="t_plans" value="billing.Plans&#10;──────────&#10;PlanId (PK)&#10;Key, ProductId (FK)&#10;Tier (10/20/30/40)" style="whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="800" y="120" width="180" height="110" as="geometry" />
        </mxCell>
        <mxCell id="t_planfeat" value="billing.PlanFeatures&#10;──────────&#10;PlanId (FK)&#10;FeatureId (FK)" style="whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="800" y="290" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="t_tenants" value="billing.Tenants&#10;──────────&#10;TenantId (PK)&#10;Name" style="whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1080" y="120" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="t_subs" value="billing.Subscriptions&#10;──────────&#10;SubscriptionId (PK)&#10;TenantId (FK), ProductId (FK)&#10;PlanId (FK), Status&#10;PeriodEnd, TrialEnd, GraceDays" style="whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="270" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="t_addons" value="billing.SubscriptionAddOns&#10;──────────&#10;SubscriptionId (FK)&#10;FeatureId (FK)" style="whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1080" y="470" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="t_view" value="billing.vEntitledPermissions (view)&#10;+ billing.fnEffectivePermissions(user)&#10;= RBAC ∩ entitlement in pure SQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="800" y="600" width="480" height="90" as="geometry" />
        </mxCell>

        <!-- relationships -->
        <mxCell id="r1" style="edgeStyle=entityRelationEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone;" edge="1" parent="1" source="t_users" target="t_userroles"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r2" style="edgeStyle=entityRelationEdgeStyle;rounded=1;html=1;endArrow=ERone;startArrow=ERmany;" edge="1" parent="1" source="t_userroles" target="t_roles"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r3" style="edgeStyle=entityRelationEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone;" edge="1" parent="1" source="t_roles" target="t_roleperms"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r4" style="edgeStyle=entityRelationEdgeStyle;rounded=1;html=1;endArrow=ERone;startArrow=ERmany;" edge="1" parent="1" source="t_roleperms" target="t_perms"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="r5" style="edgeStyle=entityRelationEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone;" edge="1" parent="1" source="t_products" target="t_features"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r6" style="edgeStyle=entityRelationEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone;" edge="1" parent="1" source="t_products" target="t_plans"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r7" style="edgeStyle=entityRelationEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone;" edge="1" parent="1" source="t_features" target="t_featperms"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r8" style="edgeStyle=entityRelationEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone;" edge="1" parent="1" source="t_plans" target="t_planfeat"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r9" style="edgeStyle=entityRelationEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone;" edge="1" parent="1" source="t_features" target="t_planfeat"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r10" style="edgeStyle=entityRelationEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone;" edge="1" parent="1" source="t_tenants" target="t_subs"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r11" style="edgeStyle=entityRelationEdgeStyle;rounded=1;html=1;endArrow=ERone;startArrow=ERmany;" edge="1" parent="1" source="t_subs" target="t_plans"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r12" style="edgeStyle=entityRelationEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone;" edge="1" parent="1" source="t_subs" target="t_addons"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- the bridge relationship (by value) -->
        <mxCell id="rbridge" value="join by permission code" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;strokeColor=#9673a6;fontStyle=1;" edge="1" parent="1" source="t_featperms" target="t_perms"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="flow" name="3. Authorization Decision">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="ftitle" value="Authorization decision — Effective = RBAC ∩ Entitlement" style="text;html=1;align=center;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="30" as="geometry" />
        </mxCell>

        <mxCell id="start" value="Request hits&#10;[RequirePermission(&quot;hire.leave.approve&quot;)]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="380" y="70" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="d0" value="Tenant &amp; user resolved?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="400" y="170" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="o401" value="401 Unauthenticated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="740" y="195" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="Subscription active?&#10;(trial / period / past-due grace)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="400" y="320" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="o402a" value="402 SubscriptionInactive&#10;→ Renew" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="740" y="350" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="d2" value="Role grants the permission?&#10;(core.* RBAC)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="400" y="490" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="o403" value="403 NotPermittedByRole&#10;→ Ask your admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="740" y="520" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="d3" value="Plan includes the feature&#10;that unlocks this permission?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="400" y="660" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="o402b" value="402 NotIncludedInPlan&#10;→ UPSELL: Upgrade plan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="690" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="allow" value="200 ALLOW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" vertex="1" parent="1">
