        <mxCell id="r12" value="ProductId" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone;dashed=1;" edge="1" parent="1" source="t_products" target="t_perms"><mxGeometry relative="1" as="geometry" /></mxCell>

