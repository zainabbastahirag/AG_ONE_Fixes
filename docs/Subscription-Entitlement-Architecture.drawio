        <!-- relationships RBAC -->
        <mxCell id="r1" style="edgeStyle=entityRelationEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone;" edge="1" parent="1" source="t_tenants" target="t_users"><mxGeometry relative="1" as="geometry" /></mxCell>
