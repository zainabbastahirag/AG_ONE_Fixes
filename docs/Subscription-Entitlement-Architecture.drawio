        <mxCell id="r15" style="edgeStyle=entityRelationEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone;" edge="1" parent="1" source="t_products" target="t_subs"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r16" value="★ NEW tier FK" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERone;startArrow=ERmany;strokeColor=#82b366;strokeWidth=2;fontStyle=1;" edge="1" parent="1" source="t_subs" target="t_tiers"><mxGeometry relative="1" as="geometry" /></mxCell>
