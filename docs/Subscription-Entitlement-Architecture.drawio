  <diagram id="erd" name="2. Data Model (agone-dev core.*)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2050" pageHeight="1320" math="0" shadow="0">
      <root>
