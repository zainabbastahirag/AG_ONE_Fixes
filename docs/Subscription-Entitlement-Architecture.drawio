<mxfile host="app.diagrams.net" agent="AG ONE architecture" version="24.0.0">
  <diagram id="arch" name="1. Solution Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="AG ONE (agone-dev) — Subscription Entitlement enforcement&#10;Effective access = RBAC permission  AND  plan-tier entitlement  (reuses core.* — 1 new table)" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="1620" height="52" as="geometry" />
        </mxCell>

        <mxCell id="g_app" value="Product app (hire / learn / work) — ASP.NET Core" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="110" width="360" height="430" as="geometry" />
        </mxCell>
        <mxCell id="g_engine" value="Entitlement engine (shared library)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="700" y="110" width="360" height="520" as="geometry" />
        </mxCell>
        <mxCell id="g_adapt" value="Adapters (EF over core.*)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1100" y="110" width="250" height="520" as="geometry" />
        </mxCell>
        <mxCell id="g_data" value="[agone-dev].[core] database" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1390" y="110" width="270" height="700" as="geometry" />
        </mxCell>

        <mxCell id="client" value="Browser / API / Mobile&#10;(JWT: user_id, tenant_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="mw" value="Tenant/User resolution middleware&#10;from claims → TenantContext" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="320" y="150" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="authz" value="[RequirePermission(&quot;hire.employee.write&quot;)]&#10;[RequireFeature(featureId)]  + policy provider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="320" y="240" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="handler" value="EntitlementAuthorizationHandler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="320" y="330" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="outcome" value="Outcome&#10;200 Allow • 403 role denies • 402 plan/billing (upsell)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="320" y="430" width="320" height="70" as="geometry" />
        </mxCell>

        <mxCell id="resolver" value="AccessResolver&#10;Effective = RBAC ∩ Entitlement&#10;(Allow / NotPermittedByRole /&#10;NotIncludedInPlan / SubscriptionInactive)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="150" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="entsvc" value="EntitlementService&#10;builds cached snapshot per (tenant, product):&#10;active tier → available features → permissions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="720" y="290" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cache" value="Snapshot cache (IMemoryCache)&#10;invalidate on subscription change" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="420" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rbacsvc" value="RBAC permission provider&#10;user → roles → permissions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="720" y="520" width="320" height="70" as="geometry" />
        </mxCell>

        <mxCell id="a_rbac" value="IUserPermissionProvider&#10;core.UserRoles → RolePermissions → Permissions&#10;(scoped by TenantId / ProductId)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1120" y="150" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a_cat" value="ICatalogProvider&#10;core.ProductFeatureModules / ProductFeatures&#10;(tier bits) + core.ProductFeaturePermissions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1120" y="290" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a_sub" value="ISubscriptionStore&#10;core.Subscriptions&#10;(status, licenses, ProductPlanTierId → tier)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1120" y="430" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a_webhook" value="Billing webhook handler&#10;update Subscription + invalidate cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1120" y="545" width="210" height="70" as="geometry" />
        </mxCell>

        <mxCell id="d_rbac" value="RBAC (existing)&#10;Users, Roles, Permissions,&#10;RolePermissions, UserRoles" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1420" y="150" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d_cat" value="Catalog (existing)&#10;Products, ProductFeatureModules,&#10;ProductFeatures (tier bits),&#10;ProductPlanTiers / Prices / Terms" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1420" y="290" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="d_sub" value="Commercial (existing)&#10;Subscriptions, Tenants&#10;(+ new ProductPlanTierId column)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1420" y="440" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d_new" value="NEW — the only injection&#10;core.ProductFeaturePermissions (bridge)&#10;+ core.vTenantEntitledPermissions (view)&#10;+ core.fnEffectivePermissions (fn)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1410" y="580" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="stripe" value="Payment / billing provider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1420" y="730" width="210" height="60" as="geometry" />
        </mxCell>

        <mxCell id="bridge" value="THE BRIDGE:  core.ProductFeaturePermissions joins core.ProductFeatures ↔ core.Permissions by permission — the only new table you add." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="300" y="660" width="1040" height="50" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="client" target="mw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="mw" target="authz"><mxGeometry relative="1" as="geometry" /></mxCell>
