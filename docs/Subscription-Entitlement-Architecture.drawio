          <mxGeometry x="1590" y="120" width="300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="t_pplans" value="core.PricingPlans&#10;──────────&#10;Id (PK)  (existing, referenced)" style="whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
