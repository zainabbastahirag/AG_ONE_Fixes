  <diagram id="flow" name="3. Authorization Decision">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="ftitle" value="Authorization decision — Effective = RBAC ∩ Entitlement" style="text;html=1;align=center;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1050" height="30" as="geometry" />
        </mxCell>

        <mxCell id="start" value="Request hits [RequirePermission(&quot;hire.leave.approve&quot;)]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="70" width="320" height="50" as="geometry" />
        </mxCell>

        <mxCell id="d0" value="Tenant &amp; user resolved from claims?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="400" y="160" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="o401" value="401 Unauthenticated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="760" y="185" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="core.Subscriptions active?&#10;(Status + EndDate + licenses)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="400" y="310" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="o402a" value="402 SubscriptionInactive → Renew" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="760" y="340" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="d2" value="Role grants the permission?&#10;(UserRoles→RolePermissions→Permissions)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="400" y="480" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="o403" value="403 NotPermittedByRole → Ask admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="760" y="515" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="d3" value="Feature that unlocks this permission&#10;is Available at the active tier?&#10;(ProductFeatures.Available{Tier} bit)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="390" y="660" width="260" height="140" as="geometry" />
        </mxCell>
        <mxCell id="o402b" value="402 NotIncludedInPlan → UPSELL upgrade tier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="695" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="d4" value="Feature IsComingSoon?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="400" y="850" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="o402c" value="402 Not yet available" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="760" y="875" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="allow" value="200 ALLOW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="420" y="1010" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="f0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="start" target="d0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f0n" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="d0" target="o401"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f1" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="d0" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f1n" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="d1" target="o402a"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f2" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f2n" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="d2" target="o403"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3n" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="d3" target="o402b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4y" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="d4" target="o402c"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4n" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="d4" target="allow"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
