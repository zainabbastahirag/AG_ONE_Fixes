{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=App_Data/agonesafe.db"
  },
  "Catalog": {
    "Directory": "App_Data/catalog"
  },
  "Executors": {
    "PowerShell": {
      "ExecutablePath": "pwsh",
      "DefaultTimeoutSeconds": 120
    },
    "Graph": {
      "BaseAddress": "https://graph.microsoft.com",
      "DefaultTimeoutSeconds": 60
    },
    "AzureResourceManager": {
      "BaseAddress": "https://management.azure.com",
      "DefaultTimeoutSeconds": 60
    },
    "Emulator": {
      "StateDirectory": "App_Data/emulator"
    }
  },
  "AgentPolicy": {
    "RequireApprovalOnFirstRemediation": true,
    "ApprovalThreshold": "Medium",
    "MultiSignatureThreshold": "Critical",
    "LargeBlastRadiusThreshold": 250
  },
  "Pax8": {
    "Enabled": false,
    "McpEndpoint": "",
    "CompanyId": ""
  }
}
