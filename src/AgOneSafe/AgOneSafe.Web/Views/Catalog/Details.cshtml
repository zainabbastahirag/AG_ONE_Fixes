@model ControlDefinition
@{
    ViewData["Title"] = Model.VendorReference;
    var audit = Model.Actions.FirstOrDefault(a => a.Kind == ControlActionKind.Audit);
    var fix = Model.Actions.FirstOrDefault(a => a.Kind == ControlActionKind.Remediate);
    var rollback = Model.Actions.FirstOrDefault(a => a.Kind == ControlActionKind.Rollback);
}

<div class="ag-page-head">
    <div>
        <h1>@Model.VendorReference — @Model.Title</h1>
        <p class="ag-sub">@Model.Description</p>
        <div class="flex" style="margin-top:8px">
            <span class="badge @ViewHelpers.LevelBadge(Model.Level)">CIS @Model.Level</span>
            <span class="badge @ViewHelpers.SeverityBadge(Model.Severity)">@Model.Severity</span>
            <span class="badge badge-neutral">@Model.Domain</span>
            <span class="badge badge-info">NIST CSF @Model.NistCsfFunction</span>
            @if (Model.RequiresLicenseUpgrade)
            {
                <span class="badge badge-medium">Requires @Model.RequiredLicense</span>
            }
        </div>
    </div>
    <a class="btn" asp-action="Index">Back to catalog</a>
</div>

<div class="ag-grid cols-2">
    <div class="ag-card">
        <h2>Benchmark metadata</h2>
        <dl class="ag-dl">
            <dt>Benchmark</dt><dd>@Model.Benchmark — @Model.BenchmarkVersion</dd>
            <dt>CIS critical control</dt><dd>@Model.CisCriticalSecurityControl</dd>
            <dt>NIST CSF category</dt><dd>@Model.NistCsfCategory</dd>
            <dt>User impact</dt><dd>@Model.UserImpact</dd>
            <dt>Risk weight</dt><dd>@Model.RiskWeight / 10</dd>
            <dt>Effort weight</dt><dd>@Model.EffortWeight / 5</dd>
            <dt>Automated audit</dt><dd>@(Model.IsAutomatedAudit ? "Yes" : "No — analyst review")</dd>
            <dt>Agentic remediation</dt><dd>@(Model.IsAutomatedRemediation ? "Yes" : "No — advisory only")</dd>
        </dl>
        @if (!string.IsNullOrWhiteSpace(Model.Rationale))
        {
            <h3 class="mt-3">Rationale</h3>
            <p class="small muted" style="margin:0">@Model.Rationale</p>
        }
    </div>

    <div class="ag-card">
        <h2>Workbook procedures</h2>
        <h3>Audit by</h3>
        <pre class="ag-code">@Model.AuditProcedure</pre>
        <h3 class="mt-3">Remediation</h3>
        <pre class="ag-code">@Model.RemediationProcedure</pre>
    </div>
</div>

@if (audit is not null)
{
    <div class="ag-card mt-3">
        <div class="ag-card-head">
            <h2>Audit action</h2>
            <div class="flex">
                <span class="badge badge-info">@audit.ExecutorType</span>
                <span class="badge badge-neutral">@audit.Module</span>
                <span class="badge badge-neutral">timeout @audit.TimeoutSeconds s</span>
            </div>
        </div>
        <pre class="ag-code">@audit.Payload</pre>

        @if (!string.IsNullOrWhiteSpace(audit.RequiredScopes))
        {
            <p class="small muted mt-3" style="margin-bottom:0">Required scopes: <span class="mono">@audit.RequiredScopes</span></p>
        }

        <h3 class="mt-3">Assertion rules (@(audit.AssertionLogic == AssertionLogic.All ? "all must pass" : "any may pass"))</h3>
        <div class="ag-table-wrap">
            <table class="ag-table">
                <thead>
                <tr><th>#</th><th>JSON path</th><th>Operator</th><th>Expected</th><th>Failure message</th><th>Required action</th></tr>
                </thead>
                <tbody>
                @foreach (var rule in audit.Assertions.OrderBy(r => r.Sequence))
                {
                    <tr>
                        <td class="num">@(rule.Sequence + 1)</td>
                        <td class="mono nowrap">@rule.JsonPath</td>
                        <td><span class="badge badge-neutral">@rule.Operator</span></td>
                        <td class="mono">@rule.ExpectedValue @(string.IsNullOrEmpty(rule.SecondaryValue) ? "" : $"… {rule.SecondaryValue}")</td>
                        <td class="wrap">@rule.FailureMessage</td>
                        <td class="wrap small muted">@rule.RemediationHint</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

@if (fix is not null)
{
    <div class="ag-card mt-3">
        <div class="ag-card-head">
            <h2>Remediation action</h2>
            <div class="flex">
                <span class="badge badge-info">@fix.ExecutorType</span>
                <span class="badge badge-neutral">@fix.Module</span>
                @if (fix.IsDestructive)
                {
                    <span class="badge badge-critical">Destructive — two approvals</span>
                }
                @if (rollback is not null)
                {
                    <span class="badge badge-pass">Rollback available</span>
                }
                else
                {
                    <span class="badge badge-medium">No rollback payload</span>
                }
            </div>
        </div>
        <pre class="ag-code">@fix.Payload</pre>

        @if (!string.IsNullOrWhiteSpace(fix.DryRunPayload))
        {
            <h3 class="mt-3">Dry-run variant</h3>
            <pre class="ag-code">@fix.DryRunPayload</pre>
        }

        @if (rollback is not null)
        {
            <h3 class="mt-3">Rollback payload</h3>
            <p class="small muted">Values in <span class="mono">{{braces}}</span> are filled from the pre-execution snapshot.</p>
            <pre class="ag-code">@rollback.Payload</pre>
        }
    </div>
}
