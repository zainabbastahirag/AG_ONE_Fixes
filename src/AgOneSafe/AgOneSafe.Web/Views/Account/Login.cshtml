@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_Layout";
}

<div style="min-height:100vh; display:grid; place-items:center; padding:24px">
    <div style="width:min(880px, 100%); display:grid; grid-template-columns:1fr 1fr; gap:22px">
        <div class="ag-card">
            <div class="ag-brand" style="padding:0 0 18px">
                <div class="ag-brand-mark">AG</div>
                <div>
                    <div class="ag-brand-name">AG ONE Safe</div>
                    <span class="ag-brand-sub">Agentic CIS assessment and remediation</span>
                </div>
            </div>

            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="All" class="validation-summary-errors"></div>

                <div class="field">
                    <label asp-for="Email">Work email</label>
                    <input asp-for="Email" autocomplete="username" autofocus />
                </div>
                <div class="field">
                    <label asp-for="Password">Password</label>
                    <input asp-for="Password" type="password" autocomplete="current-password" />
                </div>

                <button type="submit" class="btn btn-primary" style="width:100%; justify-content:center">Sign in</button>
            </form>
        </div>

        <div class="ag-card">
            <h2>Demo personas</h2>
            <p class="small muted">
                The MVP ships three roles so the human-in-the-loop gates can be exercised end to end. Critical
                changes need two distinct approvers, so sign in as both to complete one.
            </p>
            <div class="ag-table-wrap">
                <table class="ag-table">
                    <thead><tr><th>Role</th><th>Email</th><th>Can do</th></tr></thead>
                    <tbody>
                    <tr>
                        <td><span class="badge badge-info">CISO</span></td>
                        <td class="mono small">ciso@aventra.example</td>
                        <td class="small">Approve any change, accept residual risk</td>
                    </tr>
                    <tr>
                        <td><span class="badge badge-info">Engineer</span></td>
                        <td class="mono small">admin@aventra.example</td>
                        <td class="small">Scan, plan, dry run, execute, roll back</td>
                    </tr>
                    <tr>
                        <td><span class="badge badge-neutral">Auditor</span></td>
                        <td class="mono small">auditor@aventra.example</td>
                        <td class="small">Read-only posture and proof centre</td>
                    </tr>
                    </tbody>
                </table>
            </div>
            <p class="small muted mt-3">
                Password for all three: <span class="mono">AgOne!Safe2026</span>
            </p>
        </div>
    </div>
</div>
